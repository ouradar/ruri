{
  "name": "C Development (Ubuntu 24.04)",
  "build": { "dockerfile": "Dockerfile" },
  // "runArgs": ["--network=host"],
  // Configure container capabilities for high-performance networking
  "runArgs": ["--network=host", "--cap-add=NET_ADMIN"],
  // Set environment variables inside the Devcontainer to assist UHD discovery
  "containerEnv": {
    "UHD_CUSTOM_ENV_ARGS": "addr=192.168.10.2"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "gcc --version && make --version | head -n1",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "ms-vscode.cpptools-extension-pack", "ms-vscode.makefile-tools"],
      "settings": {
        "C_Cpp.default.compilerPath": "/usr/bin/gcc",
        "C_Cpp.formatting": "clangFormat",
        "editor.formatOnSave": true,
        "files.eol": "\n"
      }
    }
  }
}
